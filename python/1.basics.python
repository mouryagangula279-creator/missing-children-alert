n=int(input("Enter the n value:"))
for i in range(n+1):
    print(" "*(n-i),end=" ")
    for j in range(i):
        print("*",end=" ")
    print()
n=int(input("Enter the n value:"))
for i in range(n):
    for j in range(n):
        if(i==0 or i==n-1 or j==0 or j==n-1):
            print("*",end=" ")
        else:
            print(" ",end=" ")
    print ()
#Print number pattern
n=int(input("Enter the n value:"))
for i in range(1,n+1):
    print(i,end=" ")

n=int(input("Enter the n value:"))
for i in range(1,n+1):
    for j in range(1,n+1):
        print(j,end=" ")
    print()
n=int(input("Enter the n value:"))
for i in range(n+1):
    for j in range(n+1):
        print(i,end=" ")
    print()
n,nums=map(int,input("Enter the n value:").split())
for i in range(n+1):
    for j in range(n+1):
        print(nums,end=" ")
        nums=nums+1
    print()

n=int(input("Enter the n value:"))
for i in range(1,n+1):
    for j in range(1,n+1):
        if(i==1):
            print(j,end=" ")
        elif(i==n):
            print(n-j+1,end=" ")
        elif(j==1 or j==n):
            print(i,end=" ")
        else:
            print(" ",end=" ")
    print()
n=int(input("Enter the n value:"))
for i in range(1,n+1):
    for j in range(1,i+1):
        print(j,end=" ")
    print()
        
