n=int(input("n:"))
for i in range(1,n+1):
      print("*"*i)
print(" ")
for i in range(n,0,-1):
    print("*"*i)
for i in range(n):
    print("*"*n)
print()
for i in range(1,n+1):
    print(" "*(n-i),"*"*(2*i-1))
