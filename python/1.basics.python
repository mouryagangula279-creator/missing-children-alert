***ARRAY FUNCTIONS
--------------------
from array import*
arr=array('f',[2.5,4.8,-3.2,6.7])
for i in arr:
    if(i<0):
        continue
    print(i)
arr1=list(map(int,input().split()))
print(arr1)
for i in arr1:
    print(i)
for i,value in enumerate(arr1):
    print(i,value)
arr1.append(55)#add at last of the array
print(arr1) 
arr1.remove(10)#remove the element
print(arr1)
arr1.reverse()#reverse of the array
print(arr1)
print(len(arr1))#len of the array
arr1.sort()#sort in ascending order
print(arr1)
arr1.sort(reverse=True)#sort in descending order
print(arr1)
print(arr1.count(55))
print(arr1[3])#it print the index value
print(arr1.pop())# it deletes the last element and returns the deleted value
del arr1[3]#it removes by the index
print(arr1)
