x,y,z=map(int,input("Enter the values:").split())
if((x>y)&(x>z)):
    print("%d is a greatest number" %x)
elif((y>z)):
    print("%d is a greatest number" %y)
else:
    print("%d is a greatest number" %z)
largest=max(x,y,z)
print("%d is greatest number"% largest)



